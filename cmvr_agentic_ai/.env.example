# MongoDB (Atlas cluster with $rankFusion / Atlas Search support)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/
MONGODB_DATABASE=automotive_regulations
CMVR_RULE_COLLECTION=cmvr_rules
AIS_RULE_COLLECTION=ais_rules
RESEARCH_HISTORY_COLLECTION=research_history

# Atlas Search index names (CMVR already exist; AIS created by db/indexes.py)
CMVR_TEXT_VECTOR_INDEX=cmvr_rule_text_vector
CMVR_LEXICAL_INDEX=cmvr_rules_lexical
AIS_TEXT_VECTOR_INDEX=ais_rule_text_vector
AIS_LEXICAL_INDEX=ais_rules_lexical

# Voyage AI (embeddings + reranking)
VOYAGE_API_KEY=<voyage-api-key>
VOYAGE_EMBEDDING_MODEL=voyage-4-large
VOYAGE_RERANK_MODEL=rerank-2.5

# Grove gateway (Anthropic-compatible) — auth header is `api-key`
GROVE_API_KEY=<grove-api-key>
GROVE_MODEL=claude-fable-5
GROVE_BASE_URL=https://grove-gateway-prod.azure-api.net/grove-foundry-prod/anthropic/v1/messages
